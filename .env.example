# Public origin used for canonical URLs, hreflang, the sitemap and Open Graph.
# Defaults to https://abdallamisbah.com when unset. Override it for previews,
# e.g. a Vercel preview URL, or http://localhost:3000 to test locally.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (POST /api/contact). Server-only: never add a NEXT_PUBLIC_ prefix.
# Resend API key. While unset, the route answers 503 and the form offers a
# prefilled mailto link instead of sending.
# RESEND_API_KEY=
# Sender address; its domain must be verified with Resend.
# Defaults to "Abdalla Misbah Website <contact@abdallamisbah.com>".
# CONTACT_FROM_EMAIL="Abdalla Misbah Website <contact@abdallamisbah.com>"
# Inbox that receives the messages. Defaults to aaami1ster@gmail.com.
# CONTACT_TO_EMAIL=aaami1ster@gmail.com
